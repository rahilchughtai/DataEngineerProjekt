# Image for lake-init: creates the buckets via the S3 API and exits. Separate from the
# SeaweedFS image so the server does not have to carry Python and boto3.
FROM docker.io/library/python:3.12.16-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-cache
COPY init-buckets.py ./

# Run without root privileges (least privilege).
RUN useradd --system --uid 10001 init
USER init
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "init-buckets.py"]
