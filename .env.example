# Kopieren nach .env und alle Schlüssel durch eigene, zufällige Werte ersetzen.
# Erlaubte Zeichen in Schlüsseln: A-Z a-z 0-9 _ -

# --- Data Lake (SeaweedFS S3) ---
# Signing-Key für Filer/IAM. Ohne ihn verwirft SeaweedFS 4.x die Identitäten und läuft offen.
SEAWEEDFS_SIGNING_KEY=change-me-signing-key-min-32-chars-long

# Admin: nur für Wartung, wird von keinem Pipeline-Service verwendet
S3_ADMIN_ACCESS_KEY=admin
S3_ADMIN_SECRET_KEY=change-me-admin
# Ingestion: darf nur bronze lesen und schreiben
S3_INGESTION_ACCESS_KEY=ingestion
S3_INGESTION_SECRET_KEY=change-me-ingestion
# Spark: liest bronze, schreibt silver und gold
S3_SPARK_ACCESS_KEY=spark
S3_SPARK_SECRET_KEY=change-me-spark
# ML-Anwendung: liest nur gold
S3_ML_ACCESS_KEY=ml-reader
S3_ML_SECRET_KEY=change-me-ml

# --- Pipeline-Lauf ---
# Zeitraum für ingestion, silver-job und gold-job:
# ein Quartal (YYYYQn, z. B. 2024Q1) oder ein einzelner Monat (YYYY-MM, z. B. 2024-01)
INGEST_PERIOD=2024Q1

# --- Spark-Cluster ---
# Ressourcen pro Worker; Anzahl der Worker über docker compose up --scale spark-worker=N
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
# Speicher pro Executor, darf SPARK_WORKER_MEMORY nicht übersteigen (der Job wartet sonst endlos auf Ressourcen)
SPARK_EXECUTOR_MEMORY=1g

LOG_LEVEL=INFO
