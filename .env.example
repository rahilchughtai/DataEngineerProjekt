# Copy to .env and replace all keys with your own random values.
# Allowed characters in keys: A-Z a-z 0-9 _ -

# --- Data Lake (SeaweedFS S3) ---
# Signing key for filer/IAM. Without it SeaweedFS 4.x drops the identities and runs open.
SEAWEEDFS_SIGNING_KEY=change-me-signing-key-min-32-chars-long

# Admin: creates the buckets at startup (lake-init), otherwise only for maintenance
S3_ADMIN_ACCESS_KEY=admin
S3_ADMIN_SECRET_KEY=change-me-admin
# Ingestion: may only read and write bronze
S3_INGESTION_ACCESS_KEY=ingestion
S3_INGESTION_SECRET_KEY=change-me-ingestion
# Spark: reads bronze, writes silver and gold
S3_SPARK_ACCESS_KEY=spark
S3_SPARK_SECRET_KEY=change-me-spark
# ML application: reads gold only
S3_ML_ACCESS_KEY=ml-reader
S3_ML_SECRET_KEY=change-me-ml

# --- Data source ---
# Base URL of the TLC monthly files; ingestion downloads <URL>/yellow_tripdata_YYYY-MM.parquet
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data

# --- Pipeline run ---
# Period processed by docker compose up (required): a quarter (YYYYQn, e.g. 2024Q1) for the
# quarterly run, or a single month (YYYY-MM, e.g. 2024-03) to reprocess only that month.
# Overridable for one run: INGEST_PERIOD=2024-03 docker compose up
INGEST_PERIOD=2024Q1

# --- Spark-Cluster ---
# Resources per worker; number of workers via docker compose up --scale spark-worker=N
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
# Memory per executor, must not exceed SPARK_WORKER_MEMORY (otherwise the job waits forever for resources)
SPARK_EXECUTOR_MEMORY=1g
